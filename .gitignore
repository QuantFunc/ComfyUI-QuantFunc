# Python bytecode
__pycache__/
*.pyc

# Dynamic libraries (all platforms)
*.dll
*.so
*.dylib

# Versioned/renamed libraries: `*.so` misses `libfmt.so.8` and the
# `libquantfunc.so.bak-<tag>` engine backups (hundreds of MB each).
*.so.*
*.dll.*
*.dylib.*

# Static libraries (all platforms)
*.lib
*.a

# Keep bin directory structure but ignore libraries
# config.json and other non-binary files are still tracked

bin/linux/resource_cache.json
bin/windows/resource_cache.json
# Local Claude Code settings — never publish
.claude/

# SHA-256 integrity verify: runtime cache + heal-state (per-version manifest cache + marker)
bin/*/verify-*.json
bin/*/verify.state

# Dev-lib lock: local marker that disables auto-update so a self-built engine
# .so is not clobbered. Never publish — its presence is a per-machine choice.
bin/*/.dev_lib_lock

# Ad-hoc file/dir backups from deploy + rollback scripts
*.bak-*
.deploy-backups/
.qf_deploy_backup/
.autoloader-bak-*/
.comfyui-deploy-bak-*/
.deviceselect-bak-*/

# Local editor / code-intel tooling
.cursor/
.codegraph/
.codegraph-init.log
.codegraph-init.lock
